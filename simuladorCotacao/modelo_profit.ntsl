{ ============================================================================ }
{ ESTRATEGIA: modelo_1c_antecipado_profit_v1_1                              }
{ FINALIDADE: executar o HistGradientBoosting antecipado em NTSL            }
{ SOMENTE COMPRA | ENTRADA NA ABERTURA | BARRAS FECHADAS + GAP ATUAL        }
{ JOBLIB SHA256: B0CF382DBA5D576D4BFA0A7621ACF6CB7AFDE44FB1D69E3047E892B93C0662E6 }
{ ENSEMBLE: 150 arvores, 2240 nos, 1195 folhas }
{ GRAFICO: 1 segundo | EXECUCAO: Tick a Tick | USO: Replay/simulacao         }
{ ============================================================================ }
const
  c_Ativo = Asset(GetAsset, itSecond, 5);

input
  { Deve ser igual ao tempo do grafico usado na exportacao. }
  p_SegundosPorBarra(5);

  p_PeriodoMedia(9);
  p_PeriodoVolatilidade(20);
  p_PeriodoATR(14);
  p_PeriodoEficiencia(12);
  p_PeriodoMediaTrades(20);
  p_MinRangeBarra(10.0);
  p_MaxRangeBarra(80.0);
  p_MinMediaRangeCompra(5.0);
  p_MaxMediaRangeCompra(30.0);
  p_MinMediaRangeVenda(5.0);
  p_MaxMediaRangeVenda(30.0);
  p_DistanciaMinMedia(0.0);
  p_DistanciaMaxMedia(60.0);

  p_RecuoMinPontos(5.0);
  p_RecuoMaxPontos(20.0);
  p_ReacaoMinPontos(5.0);
  p_ValidadeSetupBarras(2);

  { 0 = automatico; 1 = exigir book; 2 = ignorar book. }
  p_ModoBook(0);
  p_NiveisBook(5);
  p_MaxSpreadTicks(2.0);
  p_MinQtdTopo(10.0);
  p_MinQtdBook(50.0);
  p_MinImbalanceTopo(0.10);
  p_MinImbalanceBook(0.05);
  p_MinDeslocamentoMicroTicks(0.05);

  p_MinAgressaoContratos(5.0);
  p_MaxAgressaoContratos(2000.0);
  p_MinAgressaoCompraFechada(5.0);
  p_MaxAgressaoCompraFechada(1500.0);
  p_MinAgressaoVendaFechada(5.0);
  p_MaxAgressaoVendaFechada(1500.0);
  p_MinRazaoAgressaoEntrada(1.20);
  p_MaxRazaoAgressaoEntrada(8.00);
  p_RazaoAgressaoSaida(1.10);
  p_MinTradesCompraFechada(10);
  p_MaxTradesCompraFechada(500);
  p_MinTradesVendaFechada(10);
  p_MaxTradesVendaFechada(500);
  p_ConfirmacoesBarras(1);
  p_PontosMinimosSetup(5);
  p_ImbalanceSaida(0.05);

  p_HorarioInicio(0915);
  p_HorarioFimEntradas(1815);

  { 1 = registrar BOOKHIST_V1 no console; 0 = desativar. }
  p_RegistrarHistoricoBook(0);


  { Parametros operacionais; nao fizeram parte do treinamento. }
  { Score logit: 0,847298 equivale a probabilidade 0,70. }
  p_CorteScoreModelo(0.847298);
  p_BarrasAquecimento(305);
  p_TempoGraficoSegundos(1);
  p_AlvoPontos(20);
  p_StopPontos(15);
  p_OffsetStop(5);
  p_Lote(1);
  { 0 desativa. Acima de 0 bloqueia saidas normais pelo tempo aproximado. }
  { A NTSL nao possui relogio documentado em milissegundos; no grafico de }
  { 1 segundo, a granularidade e uma barra, com uma barra extra de seguranca. }
  p_TempoMinimoMilissegundos(0);
  p_TempoMaxSegundos(2);
  p_CooldownBarras(5);
  p_MaxOperacoesDia(1000);
  p_LimitePerdaDia(300.0);
  p_HorarioZeragem(1820);

var
  { Preco, ritmo, tendencia e volatilidade. }
  v_RangeAtual                  : Float;
  v_CorpoAtual                  : Float;
  v_Retorno1                    : Float;
  v_Velocidade                  : Float;
  v_Aceleracao                  : Float;
  v_MediaPreco                  : Float;
  v_InclinacaoMedia             : Float;
  v_DistanciaMediaAssinada      : Float;
  v_PosicaoFechamentoRange      : Float;
  v_MediaRange                  : Float;
  v_RangeNormalizado            : Float;
  v_TradesAtual                 : Float;
  v_TrueRangeAtual              : Float;
  v_ATRRange                    : Float;
  v_GapAbertura                 : Float;
  v_Retorno3                    : Float;
  v_Retorno5                    : Float;
  v_RazaoCorpoRange             : Float;
  v_SombraSuperior             : Float;
  v_SombraInferior             : Float;
  v_TopoCorpo                   : Float;
  v_BaseCorpo                   : Float;
  v_CaminhoDirecional           : Float;
  v_EficienciaDirecional        : Float;

  { Agressao. }
  v_AgressaoCompra              : Float;
  v_AgressaoVenda               : Float;
  v_DeltaAgressao               : Float;
  v_RazaoAgressaoAssinada       : Float;
  v_VariacaoDeltaAgressao       : Float;
  v_AgressaoCompraFechada       : Float;
  v_AgressaoVendaFechada        : Float;
  v_AgressaoTotal               : Float;
  v_AgressaoLiquidaPorTrade     : Float;
  v_AgressaoTotalPorTrade       : Float;
  v_MediaTrades                 : Float;
  v_TradesRelativosMedia        : Float;
  v_ImpactoPrecoPor100Agressao  : Float;
  v_FlagDivergenciaFluxoPreco   : Float;

  { Book e micropreco. }
  v_Bid                         : Float;
  v_Ask                         : Float;
  v_QtdBid                      : Float;
  v_QtdAsk                      : Float;
  v_QtdCompraBook               : Float;
  v_QtdVendaBook                : Float;
  v_PrecoMeio                   : Float;
  v_MicroPreco                  : Float;
  v_SpreadTicks                 : Float;
  v_ImbalanceTopo               : Float;
  v_ImbalanceBook               : Float;
  v_DeslocamentoMicroTicks      : Float;
  v_ImpulsoBook                 : Float;
  v_Tick                        : Float;

  { Memoria cronologica do book. Somente para exportacao e auditoria. }
  v_QtdCompraBookPersistida     : Float;
  v_QtdVendaBookPersistida      : Float;
  v_ImbalanceBookPersistido     : Float;
  v_IdadeBookBarras             : Float;
  v_FlagBookPersistidoValido    : Float;
  v_FlagOrdemCalculoCausal      : Float;

  { Barra fechada e estados do modelo. }
  v_RangeBarraFechada           : Float;
  v_DistanciaMediaFechada       : Float;
  v_MediaRangeFechada           : Float;
  v_CorpoFechado                : Float;
  v_RetornoFechado              : Float;
  v_InclinacaoMediaFechada      : Float;
  v_PrecoReferenciaSetup        : Float;
  v_BarrasRestantesSetup        : Float;
  v_RecuoAtual                  : Float;
  v_ReacaoFavoravel             : Float;

  { Flags convertidas para zero ou um para exportacao. }
  v_FlagBookOK                  : Float;
  v_FlagAgressaoAtualOK         : Float;
  v_FlagAgressaoFechadaOK       : Float;
  v_FlagDensidadeFechadaOK      : Float;
  v_FlagRangeFechadoOK          : Float;
  v_FlagDistanciaMediaOK        : Float;
  v_FlagBaseCompra              : Float;
  v_FlagBaseVenda               : Float;
  v_FlagGatilhoCompra           : Float;
  v_FlagGatilhoVenda            : Float;
  v_FlagEventoCompraBarra       : Float;
  v_FlagEventoVendaBarra        : Float;
  v_FlagPressaoSaidaLong        : Float;
  v_FlagPressaoSaidaShort       : Float;
  v_FlagPressaoSaidaLongBarra   : Float;
  v_FlagPressaoSaidaShortBarra  : Float;
  v_FlagFiltroHorario           : Float;
  v_FlagBookPermitido           : Float;
  v_FlagUsarBookNoScore         : Float;
  v_FlagMediaRangeCompraOK      : Float;
  v_FlagMediaRangeVendaOK       : Float;
  v_FlagDensidadeCompraOK       : Float;
  v_FlagDensidadeVendaOK        : Float;
  v_FlagAgressaoCompraFaixaOK   : Float;
  v_FlagAgressaoVendaFaixaOK    : Float;
  v_FlagRazaoAgressaoCompraOK   : Float;
  v_FlagRazaoAgressaoVendaOK    : Float;
  v_FlagParametrosFaixaOK       : Float;
  v_FlagTopoOK                  : Float;
  v_FlagBookProfundoOK          : Float;

  { Estados booleanos internos. }
  v_DadosBookOK                 : Boolean;
  v_DadosTopoOK                 : Boolean;
  v_DadosBookProfundoOK         : Boolean;
  v_DadosAgressaoAtualOK        : Boolean;
  v_DadosAgressaoFechadaOK      : Boolean;
  v_DensidadeFechadaOK          : Boolean;
  v_DensidadeCompraOK           : Boolean;
  v_DensidadeVendaOK            : Boolean;
  v_RangeFechadoOK              : Boolean;
  v_DistanciaMediaOK            : Boolean;
  v_MediaRangeCompraOK          : Boolean;
  v_MediaRangeVendaOK           : Boolean;
  v_AgressaoCompraFaixaOK       : Boolean;
  v_AgressaoVendaFaixaOK        : Boolean;
  v_RazaoAgressaoCompraOK       : Boolean;
  v_RazaoAgressaoVendaOK        : Boolean;
  v_ParametrosFaixaOK           : Boolean;
  v_UsarBookNoScore             : Boolean;
  v_BookPermitido               : Boolean;
  v_BaseCompraFechada           : Boolean;
  v_BaseVendaFechada            : Boolean;
  v_GatilhoCompra               : Boolean;
  v_GatilhoVenda                : Boolean;
  v_EventoCompraBarra           : Boolean;
  v_EventoVendaBarra            : Boolean;
  v_PressaoSaidaLong            : Boolean;
  v_PressaoSaidaShort           : Boolean;
  v_PressaoSaidaLongBarra       : Boolean;
  v_PressaoSaidaShortBarra      : Boolean;
  v_FiltroHorario               : Boolean;

  { Controles de estado. }
  v_DataControle                : Integer;
  v_BarraControle               : Integer;
  v_ConfirmacaoCompra           : Integer;
  v_ConfirmacaoVenda            : Integer;
  v_PontosCompra                : Integer;
  v_PontosVenda                 : Integer;
  v_DirecaoSetup                : Integer;
  v_BarraExpiraSetup            : Integer;
  v_BarraUltimoBookValido       : Integer;
  v_UltimaBarraCalculada        : Integer;


  { Aliases usados pelo modelo antecipado. }
  v_TradesFechadaSerie        : Float;
  v_BidVsMedia                : Float;
  v_AskVsMedia                : Float;
  v_MicroVsBid                : Float;
  v_RefSetupVsMedia           : Float;
  v_FlagBidVsMediaValido      : Float;
  v_FlagAskVsMediaValido      : Float;
  v_FlagMicroVsBidValido      : Float;
  v_FlagRefSetupVsMediaValido : Float;
  v_FlagAlta                  : Float;
  v_FlagRange30               : Float;
  v_FlagClasse1C              : Float;

  v_TradesM5                  : Float;
  v_AbsDeltaM5                : Float;
  v_DeltaM5                   : Float;
  v_AbsRetM5                  : Float;
  v_RetM5                     : Float;
  v_AltaM5                    : Float;
  v_FaixaM5                   : Float;
  v_Classe1CM5                : Float;
  v_TradesM20                 : Float;
  v_AbsDeltaM20               : Float;
  v_DeltaM20                  : Float;
  v_AbsRetM20                 : Float;
  v_RetM20                    : Float;
  v_AltaM20                   : Float;
  v_FaixaM20                  : Float;
  v_Classe1CM20               : Float;
  v_TradesM60                 : Float;
  v_AbsDeltaM60               : Float;
  v_DeltaM60                  : Float;
  v_AbsRetM60                 : Float;
  v_RetM60                    : Float;
  v_AltaM60                   : Float;
  v_FaixaM60                  : Float;
  v_Classe1CM60               : Float;
  v_TradesM300                : Float;
  v_AbsDeltaM300              : Float;
  v_DeltaM300                 : Float;
  v_AbsRetM300                : Float;
  v_RetM300                   : Float;
  v_AltaM300                  : Float;
  v_FaixaM300                 : Float;
  v_Classe1CM300              : Float;

  { Estado do ensemble e gerenciamento da estrategia. }
  v_ScoreModelo               : Float;
  v_ResultadoDiaModelo        : Float;
  v_EstaPosicionadoModelo     : Boolean;
  v_PosicaoAnteriorModelo     : Boolean;
  v_SinalCompraModelo         : Boolean;
  v_BloqueioModelo            : Boolean;
  v_TempoMinimoAtingidoModelo : Boolean;
  v_DataControleModelo        : Integer;
  v_BarraScore                : Integer;
  v_BarraEntradaModelo        : Integer;
  v_UltimaBarraEntradaModelo  : Integer;
  v_CooldownAteBarraModelo    : Integer;
  v_BarrasDiaModelo           : Integer;
  v_OperacoesDiaModelo        : Integer;
  v_TempoPosicaoModelo        : Integer;

begin
  if Date <> v_DataControle then
  begin
    v_DataControle               := Date;
    v_BarraControle              := 0;
    v_ConfirmacaoCompra          := 0;
    v_ConfirmacaoVenda           := 0;
    v_PontosCompra               := 0;
    v_PontosVenda                := 0;
    v_DirecaoSetup               := 0;
    v_BarraExpiraSetup           := 0;
    v_BarraUltimoBookValido      := 0;
    v_UltimaBarraCalculada       := 0;
    v_PrecoReferenciaSetup       := 0;
    v_QtdCompraBookPersistida    := 0;
    v_QtdVendaBookPersistida     := 0;
    v_ImbalanceBookPersistido    := 0;
    v_IdadeBookBarras            := 0;
    v_FlagBookPersistidoValido   := 0;
    v_FlagOrdemCalculoCausal     := 1;
    v_EventoCompraBarra          := False;
    v_EventoVendaBarra           := False;
    v_PressaoSaidaLongBarra      := False;
    v_PressaoSaidaShortBarra     := False;
  end;

  { Detecta exportacao/recalculo em ordem inversa. Nesse caso, qualquer }
  { preenchimento por ultimo valor produziria vazamento do futuro.      }
  v_FlagOrdemCalculoCausal := 1;

  if (v_UltimaBarraCalculada > 0)
     and (CurrentBar < v_UltimaBarraCalculada) then
  begin
    v_FlagOrdemCalculoCausal    := 0;
    v_BarraUltimoBookValido     := 0;
    v_QtdCompraBookPersistida   := 0;
    v_QtdVendaBookPersistida    := 0;
    v_ImbalanceBookPersistido   := 0;
    v_IdadeBookBarras           := 0;
    v_FlagBookPersistidoValido  := 0;
  end;

  v_UltimaBarraCalculada := CurrentBar;

  { ---------------------------------------------------------------------- }
  { 1. FEATURES DE PRECO, RITMO, TENDENCIA E VOLATILIDADE                 }
  { ---------------------------------------------------------------------- }
  v_RangeAtual             := High - Low;
  v_CorpoAtual             := Close - Open;
  v_Retorno1               := Close - Close[1];
  v_TradesAtual            := Trades;
  v_MediaPreco             := Media(p_PeriodoMedia, Close);
  v_InclinacaoMedia        := v_MediaPreco - v_MediaPreco[1];
  v_DistanciaMediaAssinada := Close - v_MediaPreco;
  v_MediaRange             := Media(p_PeriodoVolatilidade, v_RangeAtual);
  v_GapAbertura            := Open - Close[1];
  v_Retorno3               := Close - Close[3];
  v_Retorno5               := Close - Close[5];

  { True range calculado sem depender de funcao de assinatura variavel. }
  v_TrueRangeAtual := High - Low;

  if Abs(High - Close[1]) > v_TrueRangeAtual then
    v_TrueRangeAtual := Abs(High - Close[1]);

  if Abs(Low - Close[1]) > v_TrueRangeAtual then
    v_TrueRangeAtual := Abs(Low - Close[1]);

  v_ATRRange := Media(p_PeriodoATR, v_TrueRangeAtual);

  if Close >= Open then
  begin
    v_TopoCorpo := Close;
    v_BaseCorpo := Open;
  end
  else
  begin
    v_TopoCorpo := Open;
    v_BaseCorpo := Close;
  end;

  v_SombraSuperior := High - v_TopoCorpo;
  v_SombraInferior := v_BaseCorpo - Low;

  if v_RangeAtual > 0 then
    v_RazaoCorpoRange := Abs(v_CorpoAtual) / v_RangeAtual
  else
    v_RazaoCorpoRange := 0;

  if p_PeriodoEficiencia > 0 then
  begin
    v_CaminhoDirecional :=
      Media(p_PeriodoEficiencia, Abs(v_Retorno1))
      * p_PeriodoEficiencia;

    if v_CaminhoDirecional > 0 then
      v_EficienciaDirecional :=
        Abs(Close - Close[p_PeriodoEficiencia])
        / v_CaminhoDirecional
    else
      v_EficienciaDirecional := 0;
  end
  else
  begin
    v_CaminhoDirecional    := 0;
    v_EficienciaDirecional := 0;
  end;

  if p_SegundosPorBarra > 0 then
  begin
    v_Velocidade := v_Retorno1 / p_SegundosPorBarra;
    v_Aceleracao :=
      (v_Velocidade - v_Velocidade[1]) / p_SegundosPorBarra;
  end
  else
  begin
    v_Velocidade := 0;
    v_Aceleracao := 0;
  end;

  if v_RangeAtual > 0 then
    v_PosicaoFechamentoRange := (Close - Low) / v_RangeAtual
  else
    v_PosicaoFechamentoRange := 0.5;

  if v_MediaRange > 0 then
    v_RangeNormalizado := v_RangeAtual / v_MediaRange
  else
    v_RangeNormalizado := 0;

  { ---------------------------------------------------------------------- }
  { 2. FEATURES DE AGRESSAO                                                }
  { ---------------------------------------------------------------------- }
  v_AgressaoCompra        := AgressionVolBuy;
  v_AgressaoVenda         := AgressionVolSell;
  v_DeltaAgressao         := v_AgressaoCompra - v_AgressaoVenda;
  v_VariacaoDeltaAgressao := v_DeltaAgressao - v_DeltaAgressao[1];
  v_AgressaoTotal         := v_AgressaoCompra + v_AgressaoVenda;
  v_MediaTrades           := Media(p_PeriodoMediaTrades, v_TradesAtual);

  if v_TradesAtual > 0 then
  begin
    v_AgressaoLiquidaPorTrade := v_DeltaAgressao / v_TradesAtual;
    v_AgressaoTotalPorTrade   := v_AgressaoTotal / v_TradesAtual;
  end
  else
  begin
    v_AgressaoLiquidaPorTrade := 0;
    v_AgressaoTotalPorTrade   := 0;
  end;

  if v_MediaTrades > 0 then
    v_TradesRelativosMedia := v_TradesAtual / v_MediaTrades
  else
    v_TradesRelativosMedia := 0;

  if v_AgressaoTotal > 0 then
    v_ImpactoPrecoPor100Agressao :=
      (Abs(v_Retorno1) * 100) / v_AgressaoTotal
  else
    v_ImpactoPrecoPor100Agressao := 0;

  if ((v_Retorno1 > 0) and (v_DeltaAgressao < 0))
     or ((v_Retorno1 < 0) and (v_DeltaAgressao > 0)) then
    v_FlagDivergenciaFluxoPreco := 1
  else
    v_FlagDivergenciaFluxoPreco := 0;

  if v_AgressaoCompra >= v_AgressaoVenda then
  begin
    if v_AgressaoVenda > 0 then
      v_RazaoAgressaoAssinada :=
        v_AgressaoCompra / v_AgressaoVenda
    else
      v_RazaoAgressaoAssinada := v_AgressaoCompra;
  end
  else
  begin
    if v_AgressaoCompra > 0 then
      v_RazaoAgressaoAssinada :=
        (-1 * v_AgressaoVenda) / v_AgressaoCompra
    else
      v_RazaoAgressaoAssinada := -1 * v_AgressaoVenda;
  end;

  v_DadosAgressaoAtualOK :=
    (v_AgressaoCompra + v_AgressaoVenda)
    >= p_MinAgressaoContratos;

  { ---------------------------------------------------------------------- }
  { 3. FEATURES DO BOOK E MICROPRECO                                       }
  { ---------------------------------------------------------------------- }
  v_Bid           := BidPrice;
  v_Ask           := AskPrice;
  v_QtdBid        := BidSize;
  v_QtdAsk        := AskSize;
  v_QtdCompraBook := TotalBuyQtd(c_Ativo, p_NiveisBook);
  v_QtdVendaBook  := TotalSellQtd(c_Ativo, p_NiveisBook);
  v_Tick          := MinPriceIncrement;

  { O topo possui serie historica em contextos onde o book profundo pode }
  { estar disponivel apenas no snapshot atual. Nao misturar as validades. }
  v_DadosTopoOK :=
    (v_Bid > 0)
    and (v_Ask > 0)
    and (v_Ask >= v_Bid)
    and ((v_QtdBid + v_QtdAsk) > 0)
    and ((v_QtdBid + v_QtdAsk) >= p_MinQtdTopo);

  v_DadosBookProfundoOK :=
    ((v_QtdCompraBook + v_QtdVendaBook) > 0)
    and ((v_QtdCompraBook + v_QtdVendaBook) >= p_MinQtdBook);

  v_DadosBookOK := v_DadosTopoOK and v_DadosBookProfundoOK;

  { Spread, imbalance do topo e micropreco usam somente o topo. }
  if v_DadosTopoOK then
  begin
    v_PrecoMeio := (v_Bid + v_Ask) / 2;

    if v_Tick > 0 then
      v_SpreadTicks := (v_Ask - v_Bid) / v_Tick
    else
      v_SpreadTicks := 999;

    v_ImbalanceTopo :=
      (v_QtdBid - v_QtdAsk) / (v_QtdBid + v_QtdAsk);
    v_MicroPreco :=
      ((v_Ask * v_QtdBid) + (v_Bid * v_QtdAsk))
      / (v_QtdBid + v_QtdAsk);

    if v_Tick > 0 then
      v_DeslocamentoMicroTicks :=
        (v_MicroPreco - v_PrecoMeio) / v_Tick
    else
      v_DeslocamentoMicroTicks := 0;
  end
  else
  begin
    v_PrecoMeio              := Close;
    v_MicroPreco             := Close;
    v_SpreadTicks            := 999;
    v_ImbalanceTopo          := 0;
    v_DeslocamentoMicroTicks := 0;
  end;

  { Book profundo nao e inventado quando a plataforma nao fornece historico. }
  if v_DadosBookProfundoOK then
  begin
    v_ImbalanceBook :=
      (v_QtdCompraBook - v_QtdVendaBook)
      / (v_QtdCompraBook + v_QtdVendaBook);

    if (v_QtdCompraBook[1] + v_QtdVendaBook[1]) > 0 then
      v_ImpulsoBook :=
        (v_QtdCompraBook - v_QtdCompraBook[1])
        - (v_QtdVendaBook - v_QtdVendaBook[1])
    else
      v_ImpulsoBook := 0;
  end
  else
  begin
    v_ImbalanceBook := 0;
    v_ImpulsoBook   := 0;
  end;

  { ---------------------------------------------------------------------- }
  { MEMORIA DO BOOK PARA EXPORTACAO                                        }
  {                                                                        }
  { TotalBuyQtd/TotalSellQtd nao possuem historico confiavel no Profit.    }
  { Durante Replay cronologico, preservamos a ultima leitura realmente     }
  { observada. A idade permite distinguir dado atual de dado carregado.     }
  { Esta memoria NAO participa dos sinais nem das decisoes do modelo.       }
  { ---------------------------------------------------------------------- }
  if (v_FlagOrdemCalculoCausal = 1)
     and v_DadosBookProfundoOK then
  begin
    v_QtdCompraBookPersistida  := v_QtdCompraBook;
    v_QtdVendaBookPersistida   := v_QtdVendaBook;
    v_ImbalanceBookPersistido  := v_ImbalanceBook;
    v_BarraUltimoBookValido    := CurrentBar;
    v_IdadeBookBarras          := 0;
    v_FlagBookPersistidoValido := 1;
  end
  else if (v_FlagOrdemCalculoCausal = 1)
          and (v_BarraUltimoBookValido > 0) then
  begin
    v_IdadeBookBarras          := CurrentBar - v_BarraUltimoBookValido;
    v_FlagBookPersistidoValido := 1;
  end
  else
  begin
    v_QtdCompraBookPersistida  := 0;
    v_QtdVendaBookPersistida   := 0;
    v_ImbalanceBookPersistido  := 0;
    v_IdadeBookBarras          := 0;
    v_FlagBookPersistidoValido := 0;
  end;

  v_UsarBookNoScore :=
    v_DadosBookOK
    and (p_ModoBook <> 2)
    and (v_SpreadTicks <= p_MaxSpreadTicks);
  v_BookPermitido :=
    (p_ModoBook <> 1)
    or v_UsarBookNoScore;

  v_FiltroHorario :=
    (Time >= p_HorarioInicio)
    and (Time < p_HorarioFimEntradas);

  v_ParametrosFaixaOK :=
    (p_MinRangeBarra <= p_MaxRangeBarra)
    and (p_MinMediaRangeCompra <= p_MaxMediaRangeCompra)
    and (p_MinMediaRangeVenda <= p_MaxMediaRangeVenda)
    and (p_DistanciaMinMedia <= p_DistanciaMaxMedia)
    and (p_RecuoMinPontos <= p_RecuoMaxPontos)
    and (p_MinAgressaoContratos <= p_MaxAgressaoContratos)
    and (p_MinAgressaoCompraFechada <= p_MaxAgressaoCompraFechada)
    and (p_MinAgressaoVendaFechada <= p_MaxAgressaoVendaFechada)
    and (p_MinRazaoAgressaoEntrada <= p_MaxRazaoAgressaoEntrada)
    and (p_MinTradesCompraFechada <= p_MaxTradesCompraFechada)
    and (p_MinTradesVendaFechada <= p_MaxTradesVendaFechada)
    and (p_PeriodoATR > 0)
    and (p_PeriodoEficiencia > 0)
    and (p_PeriodoMediaTrades > 0);

  { ---------------------------------------------------------------------- }
  { 4. ESTADO DO SETUP, ATUALIZADO UMA VEZ POR BARRA                      }
  { ---------------------------------------------------------------------- }
  if CurrentBar <> v_BarraControle then
  begin
    v_BarraControle              := CurrentBar;

    { ------------------------------------------------------------------ }
    { PERSISTENCIA DO BOOK                                                }
    {                                                                    }
    { O Profit normalmente conserva o book apenas na barra atual e na    }
    { anterior. No primeiro calculo da nova barra, [1] ainda representa  }
    { o snapshot que acabou de fechar. Ele e gravado no ConsoleLog antes }
    { que uma recalculacao posterior devolva zero para o passado.         }
    {                                                                    }
    { Somente snapshots realmente observados sao registrados. Zero de    }
    { book historico nao e tratado como quantidade real.                  }
    { ------------------------------------------------------------------ }
    if (p_RegistrarHistoricoBook = 1)
       and (CurrentBar > 2)
       and (
         ((v_Bid[1] > 0) and (v_Ask[1] > 0)
          and ((v_QtdBid[1] + v_QtdAsk[1]) > 0))
         or ((v_QtdCompraBook[1] + v_QtdVendaBook[1]) > 0)
       ) then
    begin
      ConsoleLog(
        "BOOKHIST_V1;"
        + Date[1] + ";"
        + Time[1] + ";"
        + CurrentBar + ";"
        + Close[1] + ";"
        + v_Bid[1] + ";"
        + v_Ask[1] + ";"
        + v_QtdBid[1] + ";"
        + v_QtdAsk[1] + ";"
        + v_ImbalanceTopo[1] + ";"
        + v_QtdCompraBook[1] + ";"
        + v_QtdVendaBook[1] + ";"
        + v_ImbalanceBook[1] + ";"
        + v_MicroPreco[1] + ";"
        + v_DeslocamentoMicroTicks[1] + ";"
        + v_ImpulsoBook[1] + ";"
        + v_FlagTopoOK[1] + ";"
        + v_FlagBookProfundoOK[1] + ";"
        + v_TradesAtual[1] + ";"
        + v_AgressaoCompra[1] + ";"
        + v_AgressaoVenda[1]
      );
    end;

    v_EventoCompraBarra          := False;
    v_EventoVendaBarra           := False;
    v_PressaoSaidaLongBarra      := False;
    v_PressaoSaidaShortBarra     := False;
    v_PontosCompra               := 0;
    v_PontosVenda                := 0;
    v_AgressaoCompraFechada      := v_AgressaoCompra[1];
    v_AgressaoVendaFechada       := v_AgressaoVenda[1];
    v_RangeBarraFechada          := High[1] - Low[1];
    v_DistanciaMediaFechada      := Abs(Close[1] - v_MediaPreco[1]);
    v_MediaRangeFechada          := v_MediaRange[1];
    v_CorpoFechado               := Close[1] - Open[1];
    v_RetornoFechado             := Close[1] - Close[2];
    v_InclinacaoMediaFechada     :=
      v_MediaPreco[1] - v_MediaPreco[2];

    v_RangeFechadoOK :=
      (v_RangeBarraFechada >= p_MinRangeBarra)
      and (v_RangeBarraFechada <= p_MaxRangeBarra);
    v_DistanciaMediaOK :=
      (v_DistanciaMediaFechada >= p_DistanciaMinMedia)
      and (v_DistanciaMediaFechada <= p_DistanciaMaxMedia);
    v_MediaRangeCompraOK :=
      (v_MediaRangeFechada >= p_MinMediaRangeCompra)
      and (v_MediaRangeFechada <= p_MaxMediaRangeCompra);
    v_MediaRangeVendaOK :=
      (v_MediaRangeFechada >= p_MinMediaRangeVenda)
      and (v_MediaRangeFechada <= p_MaxMediaRangeVenda);
    v_DadosAgressaoFechadaOK :=
      ((v_AgressaoCompraFechada + v_AgressaoVendaFechada)
       >= p_MinAgressaoContratos)
      and
      ((v_AgressaoCompraFechada + v_AgressaoVendaFechada)
       <= p_MaxAgressaoContratos);
    v_DensidadeCompraOK :=
      (v_TradesAtual[1] >= p_MinTradesCompraFechada)
      and (v_TradesAtual[1] <= p_MaxTradesCompraFechada);
    v_DensidadeVendaOK :=
      (v_TradesAtual[1] >= p_MinTradesVendaFechada)
      and (v_TradesAtual[1] <= p_MaxTradesVendaFechada);
    v_DensidadeFechadaOK :=
      v_DensidadeCompraOK or v_DensidadeVendaOK;
    v_AgressaoCompraFaixaOK :=
      (v_AgressaoCompraFechada >= p_MinAgressaoCompraFechada)
      and (v_AgressaoCompraFechada <= p_MaxAgressaoCompraFechada);
    v_AgressaoVendaFaixaOK :=
      (v_AgressaoVendaFechada >= p_MinAgressaoVendaFechada)
      and (v_AgressaoVendaFechada <= p_MaxAgressaoVendaFechada);

    if v_AgressaoVendaFechada > 0 then
      v_RazaoAgressaoCompraOK :=
        (v_AgressaoCompraFechada >=
         (p_MinRazaoAgressaoEntrada * v_AgressaoVendaFechada))
        and
        (v_AgressaoCompraFechada <=
         (p_MaxRazaoAgressaoEntrada * v_AgressaoVendaFechada))
    else
      v_RazaoAgressaoCompraOK := v_AgressaoCompraFechada > 0;

    if v_AgressaoCompraFechada > 0 then
      v_RazaoAgressaoVendaOK :=
        (v_AgressaoVendaFechada >=
         (p_MinRazaoAgressaoEntrada * v_AgressaoCompraFechada))
        and
        (v_AgressaoVendaFechada <=
         (p_MaxRazaoAgressaoEntrada * v_AgressaoCompraFechada))
    else
      v_RazaoAgressaoVendaOK := v_AgressaoVendaFechada > 0;

    if v_DensidadeCompraOK then
      v_PontosCompra := v_PontosCompra + 1;

    if v_DensidadeVendaOK then
      v_PontosVenda  := v_PontosVenda + 1;

    if (Close[1] > Open[1]) and (Close[1] > Close[2]) then
      v_PontosCompra := v_PontosCompra + 2
    else if (Close[1] < Open[1]) and (Close[1] < Close[2]) then
      v_PontosVenda := v_PontosVenda + 2;

    if (Close[1] > v_MediaPreco[1])
       and (v_MediaPreco[1] >= v_MediaPreco[2]) then
      v_PontosCompra := v_PontosCompra + 1
    else if (Close[1] < v_MediaPreco[1])
            and (v_MediaPreco[1] <= v_MediaPreco[2]) then
      v_PontosVenda := v_PontosVenda + 1;

    if v_DadosAgressaoFechadaOK then
    begin
      if v_AgressaoCompraFaixaOK
         and v_RazaoAgressaoCompraOK then
        v_PontosCompra := v_PontosCompra + 2;

      if v_AgressaoVendaFaixaOK
         and v_RazaoAgressaoVendaOK then
        v_PontosVenda := v_PontosVenda + 2;
    end;

    if v_UsarBookNoScore then
    begin
      if v_ImbalanceTopo >= p_MinImbalanceTopo then
        v_PontosCompra := v_PontosCompra + 1;
      if v_ImbalanceTopo <= (-1 * p_MinImbalanceTopo) then
        v_PontosVenda := v_PontosVenda + 1;

      if v_ImbalanceBook >= p_MinImbalanceBook then
        v_PontosCompra := v_PontosCompra + 1;
      if v_ImbalanceBook <= (-1 * p_MinImbalanceBook) then
        v_PontosVenda := v_PontosVenda + 1;

      if v_DeslocamentoMicroTicks >= p_MinDeslocamentoMicroTicks then
        v_PontosCompra := v_PontosCompra + 1;
      if v_DeslocamentoMicroTicks <=
         (-1 * p_MinDeslocamentoMicroTicks) then
        v_PontosVenda := v_PontosVenda + 1;
    end;

    v_BaseCompraFechada :=
      v_ParametrosFaixaOK
      and v_RangeFechadoOK
      and v_DistanciaMediaOK
      and v_MediaRangeCompraOK
      and v_DensidadeCompraOK
      and (v_PontosCompra >= p_PontosMinimosSetup)
      and (v_PontosCompra > v_PontosVenda);
    v_BaseVendaFechada :=
      v_ParametrosFaixaOK
      and v_RangeFechadoOK
      and v_DistanciaMediaOK
      and v_MediaRangeVendaOK
      and v_DensidadeVendaOK
      and (v_PontosVenda >= p_PontosMinimosSetup)
      and (v_PontosVenda > v_PontosCompra);

    if v_BaseCompraFechada then
    begin
      v_ConfirmacaoCompra := v_ConfirmacaoCompra + 1;
      v_ConfirmacaoVenda  := 0;
    end
    else if v_BaseVendaFechada then
    begin
      v_ConfirmacaoVenda  := v_ConfirmacaoVenda + 1;
      v_ConfirmacaoCompra := 0;
    end
    else
    begin
      v_ConfirmacaoCompra := 0;
      v_ConfirmacaoVenda  := 0;
    end;

    if v_ConfirmacaoCompra >= p_ConfirmacoesBarras then
    begin
      v_DirecaoSetup         := 1;
      v_PrecoReferenciaSetup := Close[1];
      v_BarraExpiraSetup     := CurrentBar + p_ValidadeSetupBarras;
      v_ConfirmacaoCompra    := 0;
    end
    else if v_ConfirmacaoVenda >= p_ConfirmacoesBarras then
    begin
      v_DirecaoSetup         := -1;
      v_PrecoReferenciaSetup := Close[1];
      v_BarraExpiraSetup     := CurrentBar + p_ValidadeSetupBarras;
      v_ConfirmacaoVenda     := 0;
    end;
  end;

  if (v_DirecaoSetup <> 0)
     and (CurrentBar > v_BarraExpiraSetup) then
  begin
    v_DirecaoSetup         := 0;
    v_PrecoReferenciaSetup := 0;
  end;

  if v_DirecaoSetup <> 0 then
  begin
    v_BarrasRestantesSetup := v_BarraExpiraSetup - CurrentBar;
    v_RecuoAtual :=
      (v_PrecoReferenciaSetup - Close) * v_DirecaoSetup;

    if v_DirecaoSetup = 1 then
      v_ReacaoFavoravel := Close - Low
    else
      v_ReacaoFavoravel := High - Close;
  end
  else
  begin
    v_BarrasRestantesSetup := 0;
    v_RecuoAtual           := 0;
    v_ReacaoFavoravel      := 0;
  end;

  v_GatilhoCompra :=
    (v_DirecaoSetup = 1)
    and (Close <= (v_PrecoReferenciaSetup - p_RecuoMinPontos))
    and (Close >= (v_PrecoReferenciaSetup - p_RecuoMaxPontos))
    and (Close >= (Low + p_ReacaoMinPontos))
    and (Close >= v_MediaPreco)
    and v_BookPermitido
    and v_FiltroHorario;

  v_GatilhoVenda :=
    (v_DirecaoSetup = -1)
    and (Close >= (v_PrecoReferenciaSetup + p_RecuoMinPontos))
    and (Close <= (v_PrecoReferenciaSetup + p_RecuoMaxPontos))
    and (Close <= (High - p_ReacaoMinPontos))
    and (Close <= v_MediaPreco)
    and v_BookPermitido
    and v_FiltroHorario;

  if v_GatilhoCompra then
  begin
    v_EventoCompraBarra    := True;
    v_DirecaoSetup         := 0;
  end
  else if v_GatilhoVenda then
  begin
    v_EventoVendaBarra     := True;
    v_DirecaoSetup         := 0;
  end;

  { Pressao de saida e calculada sem depender de uma posicao real. }
  v_PressaoSaidaLong :=
    (Close < Open)
    and
    (
      (v_DadosAgressaoAtualOK
       and (v_AgressaoVenda >=
            (p_RazaoAgressaoSaida * v_AgressaoCompra)))
      or
      (v_UsarBookNoScore
       and (v_ImbalanceBook <= (-1 * p_ImbalanceSaida))
       and (v_DeslocamentoMicroTicks < 0))
    );

  v_PressaoSaidaShort :=
    (Close > Open)
    and
    (
      (v_DadosAgressaoAtualOK
       and (v_AgressaoCompra >=
            (p_RazaoAgressaoSaida * v_AgressaoVenda)))
      or
      (v_UsarBookNoScore
       and (v_ImbalanceBook >= p_ImbalanceSaida)
       and (v_DeslocamentoMicroTicks > 0))
    );

  if v_PressaoSaidaLong then
    v_PressaoSaidaLongBarra := True;
  if v_PressaoSaidaShort then
    v_PressaoSaidaShortBarra := True;

  { ---------------------------------------------------------------------- }
  { 5. CONVERSAO DOS ESTADOS BOOLEANOS PARA COLUNAS NUMERICAS             }
  { ---------------------------------------------------------------------- }
  if v_DadosBookOK then v_FlagBookOK := 1 else v_FlagBookOK := 0;
  if v_DadosAgressaoAtualOK then v_FlagAgressaoAtualOK := 1 else v_FlagAgressaoAtualOK := 0;
  if v_DadosAgressaoFechadaOK then v_FlagAgressaoFechadaOK := 1 else v_FlagAgressaoFechadaOK := 0;
  if v_DensidadeFechadaOK then v_FlagDensidadeFechadaOK := 1 else v_FlagDensidadeFechadaOK := 0;
  if v_RangeFechadoOK then v_FlagRangeFechadoOK := 1 else v_FlagRangeFechadoOK := 0;
  if v_DistanciaMediaOK then v_FlagDistanciaMediaOK := 1 else v_FlagDistanciaMediaOK := 0;
  if v_BaseCompraFechada then v_FlagBaseCompra := 1 else v_FlagBaseCompra := 0;
  if v_BaseVendaFechada then v_FlagBaseVenda := 1 else v_FlagBaseVenda := 0;
  if v_GatilhoCompra then v_FlagGatilhoCompra := 1 else v_FlagGatilhoCompra := 0;
  if v_GatilhoVenda then v_FlagGatilhoVenda := 1 else v_FlagGatilhoVenda := 0;
  if v_EventoCompraBarra then v_FlagEventoCompraBarra := 1 else v_FlagEventoCompraBarra := 0;
  if v_EventoVendaBarra then v_FlagEventoVendaBarra := 1 else v_FlagEventoVendaBarra := 0;
  if v_PressaoSaidaLong then v_FlagPressaoSaidaLong := 1 else v_FlagPressaoSaidaLong := 0;
  if v_PressaoSaidaShort then v_FlagPressaoSaidaShort := 1 else v_FlagPressaoSaidaShort := 0;
  if v_PressaoSaidaLongBarra then v_FlagPressaoSaidaLongBarra := 1 else v_FlagPressaoSaidaLongBarra := 0;
  if v_PressaoSaidaShortBarra then v_FlagPressaoSaidaShortBarra := 1 else v_FlagPressaoSaidaShortBarra := 0;
  if v_FiltroHorario then v_FlagFiltroHorario := 1 else v_FlagFiltroHorario := 0;
  if v_BookPermitido then v_FlagBookPermitido := 1 else v_FlagBookPermitido := 0;
  if v_UsarBookNoScore then v_FlagUsarBookNoScore := 1 else v_FlagUsarBookNoScore := 0;
  if v_MediaRangeCompraOK then v_FlagMediaRangeCompraOK := 1 else v_FlagMediaRangeCompraOK := 0;
  if v_MediaRangeVendaOK then v_FlagMediaRangeVendaOK := 1 else v_FlagMediaRangeVendaOK := 0;
  if v_DensidadeCompraOK then v_FlagDensidadeCompraOK := 1 else v_FlagDensidadeCompraOK := 0;
  if v_DensidadeVendaOK then v_FlagDensidadeVendaOK := 1 else v_FlagDensidadeVendaOK := 0;
  if v_AgressaoCompraFaixaOK then v_FlagAgressaoCompraFaixaOK := 1 else v_FlagAgressaoCompraFaixaOK := 0;
  if v_AgressaoVendaFaixaOK then v_FlagAgressaoVendaFaixaOK := 1 else v_FlagAgressaoVendaFaixaOK := 0;
  if v_RazaoAgressaoCompraOK then v_FlagRazaoAgressaoCompraOK := 1 else v_FlagRazaoAgressaoCompraOK := 0;
  if v_RazaoAgressaoVendaOK then v_FlagRazaoAgressaoVendaOK := 1 else v_FlagRazaoAgressaoVendaOK := 0;
  if v_ParametrosFaixaOK then v_FlagParametrosFaixaOK := 1 else v_FlagParametrosFaixaOK := 0;
  if v_DadosTopoOK then v_FlagTopoOK := 1 else v_FlagTopoOK := 0;
  if v_DadosBookProfundoOK then v_FlagBookProfundoOK := 1 else v_FlagBookProfundoOK := 0;


  { ---------------------------------------------------------------------- }
  { 6. FEATURES ADICIONAIS EXATAS DO MODELO PYTHON                        }
  { ---------------------------------------------------------------------- }
  v_TradesFechadaSerie := v_TradesAtual[1];

  v_BidVsMedia := v_Bid - v_MediaPreco;
  if Abs(v_BidVsMedia) <= 500 then
    v_FlagBidVsMediaValido := 1
  else
  begin
    v_BidVsMedia := 0;
    v_FlagBidVsMediaValido := 0;
  end;

  v_AskVsMedia := v_Ask - v_MediaPreco;
  if Abs(v_AskVsMedia) <= 500 then
    v_FlagAskVsMediaValido := 1
  else
  begin
    v_AskVsMedia := 0;
    v_FlagAskVsMediaValido := 0;
  end;

  v_MicroVsBid := v_MicroPreco - v_Bid;
  if Abs(v_MicroVsBid) <= 500 then
    v_FlagMicroVsBidValido := 1
  else
  begin
    v_MicroVsBid := 0;
    v_FlagMicroVsBidValido := 0;
  end;

  if v_PrecoReferenciaSetup <> 0 then
  begin
    v_RefSetupVsMedia := v_PrecoReferenciaSetup - v_MediaPreco;
    if Abs(v_RefSetupVsMedia) <= 500 then
      v_FlagRefSetupVsMediaValido := 1
    else
    begin
      v_RefSetupVsMedia := 0;
      v_FlagRefSetupVsMediaValido := 0;
    end;
  end
  else
  begin
    v_RefSetupVsMedia := 0;
    v_FlagRefSetupVsMediaValido := 0;
  end;

  if v_Retorno1 > 0 then v_FlagAlta := 1 else v_FlagAlta := 0;
  if v_RangeAtual >= 30 then v_FlagRange30 := 1 else v_FlagRange30 := 0;
  if (v_RangeAtual >= 30) and (v_CorpoAtual > 0) then
    v_FlagClasse1C := 1
  else
    v_FlagClasse1C := 0;

  v_TradesM5     := Media(5, v_TradesAtual);
  v_AbsDeltaM5   := Media(5, Abs(v_DeltaAgressao));
  v_DeltaM5      := Media(5, v_DeltaAgressao);
  v_AbsRetM5     := Media(5, Abs(v_Retorno1));
  v_RetM5        := Media(5, v_Retorno1);
  v_AltaM5       := Media(5, v_FlagAlta);
  v_FaixaM5      := Media(5, v_FlagRange30);
  v_Classe1CM5   := Media(5, v_FlagClasse1C);
  v_TradesM20    := Media(20, v_TradesAtual);
  v_AbsDeltaM20  := Media(20, Abs(v_DeltaAgressao));
  v_DeltaM20     := Media(20, v_DeltaAgressao);
  v_AbsRetM20    := Media(20, Abs(v_Retorno1));
  v_RetM20       := Media(20, v_Retorno1);
  v_AltaM20      := Media(20, v_FlagAlta);
  v_FaixaM20     := Media(20, v_FlagRange30);
  v_Classe1CM20  := Media(20, v_FlagClasse1C);
  v_TradesM60    := Media(60, v_TradesAtual);
  v_AbsDeltaM60  := Media(60, Abs(v_DeltaAgressao));
  v_DeltaM60     := Media(60, v_DeltaAgressao);
  v_AbsRetM60    := Media(60, Abs(v_Retorno1));
  v_RetM60       := Media(60, v_Retorno1);
  v_AltaM60      := Media(60, v_FlagAlta);
  v_FaixaM60     := Media(60, v_FlagRange30);
  v_Classe1CM60  := Media(60, v_FlagClasse1C);
  v_TradesM300   := Media(300, v_TradesAtual);
  v_AbsDeltaM300 := Media(300, Abs(v_DeltaAgressao));
  v_DeltaM300    := Media(300, v_DeltaAgressao);
  v_AbsRetM300   := Media(300, Abs(v_Retorno1));
  v_RetM300      := Media(300, v_Retorno1);
  v_AltaM300     := Media(300, v_FlagAlta);
  v_FaixaM300    := Media(300, v_FlagRange30);
  v_Classe1CM300 := Media(300, v_FlagClasse1C);


  { ---------------------------------------------------------------------- }
  { 7. CONTROLES OPERACIONAIS                                              }
  { ---------------------------------------------------------------------- }
  if Date <> v_DataControleModelo then
  begin
    v_DataControleModelo       := Date;
    v_BarraScore               := 0;
    v_BarraEntradaModelo       := 0;
    v_UltimaBarraEntradaModelo := 0;
    v_CooldownAteBarraModelo   := 0;
    v_BarrasDiaModelo          := 0;
    v_OperacoesDiaModelo       := 0;
    v_PosicaoAnteriorModelo    := False;
    v_SinalCompraModelo        := False;
  end;

  v_EstaPosicionadoModelo := IsBought or IsSold;
  v_ResultadoDiaModelo    := DailyResult(True);

  if v_EstaPosicionadoModelo and (not v_PosicaoAnteriorModelo) then
  begin
    v_BarraEntradaModelo  := CurrentBar;
    v_OperacoesDiaModelo  := v_OperacoesDiaModelo + 1;
  end;

  if (not v_EstaPosicionadoModelo) and v_PosicaoAnteriorModelo then
  begin
    v_BarraEntradaModelo      := 0;
    v_CooldownAteBarraModelo  := CurrentBar + p_CooldownBarras;
  end;

  if v_EstaPosicionadoModelo and (v_BarraEntradaModelo > 0) then
    v_TempoPosicaoModelo :=
      (CurrentBar - v_BarraEntradaModelo) * p_TempoGraficoSegundos
  else
    v_TempoPosicaoModelo := 0;

  { O Profit/NTSL nao expoe um relogio de mercado em milissegundos.       }
  { Assim, o tempo minimo e aproximado pela quantidade de barras.         }
  { Usa uma barra adicional para nao liberar antes do minimo solicitado.   }
  if p_TempoMinimoMilissegundos <= 0 then
    v_TempoMinimoAtingidoModelo := True
  else if p_TempoGraficoSegundos > 0 then
    v_TempoMinimoAtingidoModelo :=
      ((v_TempoPosicaoModelo - p_TempoGraficoSegundos) * 1000)
      >= p_TempoMinimoMilissegundos
  else
    v_TempoMinimoAtingidoModelo := False;

  v_BloqueioModelo :=
    (v_ResultadoDiaModelo <= (-1 * p_LimitePerdaDia))
    or (v_OperacoesDiaModelo >= p_MaxOperacoesDia);

  { A pontuacao e atualizada uma unica vez na abertura de cada barra. }
  if CurrentBar <> v_BarraScore then
  begin
    v_BarraScore        := CurrentBar;
    v_BarrasDiaModelo   := v_BarrasDiaModelo + 1;
    v_SinalCompraModelo := False;

    if v_BarrasDiaModelo >= p_BarrasAquecimento then
    begin
  v_ScoreModelo := 0.00001634240869911;
  { Arvore 001 de 150. }
  if v_ATRRange[1] <= 20.359999999999999 then
  begin
    if v_ATRRange[1] <= 14.640000000000001 then
    begin
      if v_TradesAtual[1] <= 201 then
      begin
        v_ScoreModelo := v_ScoreModelo + (-0.04511622259751974);
      end
      else
      begin
        v_ScoreModelo := v_ScoreModelo + (-0.018651115267613604);
      end;
    end
    else
    begin
      if v_FaixaM300[1] <= 0.12666666666666668 then
      begin
        v_ScoreModelo := v_ScoreModelo + (-0.022463871519943546);
      end
      else
      begin
        v_ScoreModelo := v_ScoreModelo + (-0.00008826232080664);
      end;
    end;
  end
