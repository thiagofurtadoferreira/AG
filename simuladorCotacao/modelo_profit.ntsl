    if IsBought then
      SellToCoverAtMarket(p_Lote)
    else if IsSold then
      BuyToCoverAtMarket(p_Lote);
  end
  else if IsBought then
  begin
    if not v_TempoMinimoAtingidoModelo then
    begin
      { Nao deixa ordens de saida normais ativas antes do tempo minimo. }
      if HasPendingOrders then
        CancelPendingOrders;
    end
    else if v_TempoPosicaoModelo >= p_TempoMaxSegundos then
    begin
      if HasPendingOrders then
        CancelPendingOrders;
      SellToCoverAtMarket(p_Lote);
    end
    else
    begin
      SellToCoverLimit(BuyPrice + p_AlvoPontos, p_Lote);
      SellToCoverStop(
        BuyPrice - p_StopPontos,
        BuyPrice - p_StopPontos - p_OffsetStop,
        p_Lote
      );
    end;
  end
  else if IsSold then
  begin
    if HasPendingOrders then
      CancelPendingOrders;
    BuyToCoverAtMarket(p_Lote);
  end
  else
  begin
    if HasPendingOrders then
      CancelPendingOrders;

    if v_SinalCompraModelo
       and (Time >= p_HorarioInicio)
       and (Time < p_HorarioFimEntradas)
       and (not v_BloqueioModelo)
       and (CurrentBar >= v_CooldownAteBarraModelo)
       and (CurrentBar <> v_UltimaBarraEntradaModelo) then
    begin
      BuyAtMarket(p_Lote);
      v_UltimaBarraEntradaModelo := CurrentBar;
    end;
  end;

  v_PosicaoAnteriorModelo := v_EstaPosicionadoModelo;
