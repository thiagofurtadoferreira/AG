input
  Periodo(9);
  Lote(1);

var
  LinhaMedia : Float;

begin
  LinhaMedia := Media(Periodo, Close);
  Plot(LinhaMedia);

  if CurrentBar > Periodo then
  begin
    if IsBought then
    begin
      if Close < LinhaMedia then
        SellToCoverAtMarket(Lote);
    end
    else if Close > LinhaMedia then
      BuyAtMarket(Lote);
  end;
end;
